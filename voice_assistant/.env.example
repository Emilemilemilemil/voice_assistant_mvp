SAMPLE_RATE=16000
CHANNELS=1
CHUNK_MS=32

# Optional: index of the input device. Empty = system default.
MIC_DEVICE=

VAD_THRESHOLD=0.50
MIN_SPEECH_MS=180
END_SILENCE_MS=700
MAX_UTTERANCE_MS=15000
MAX_LISTEN_MS=30000
PRE_ROLL_MS=400

WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=5

LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=local
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
# Provider: "ollama" sends reasoning_effort/keep_alive, "openai" sends standard params only
LLM_PROVIDER=ollama

# Empty = default paths under ~/voice_assistant_mvp
PIPER_BIN=
PIPER_MODEL=
PIPER_SPEAKER=
PIPER_LENGTH_SCALE=1.0
